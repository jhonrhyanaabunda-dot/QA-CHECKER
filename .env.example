# ───────────────────────────────────────────────────────────────────────────
# DealerQA AI — Environment configuration
#
# The app runs with NONE of these set (zero-setup mode):
#   • Crawling, link checking, claim detection, compliance, scoring, and the
#     FuelEconomy.gov / NHTSA fact-checks all work with no keys.
#   • The LLM layer falls back to a deterministic rule-based analyzer.
#   • Audits persist to a local JSON store under ./.data/.
#
# Add keys below to progressively light up the cloud-grade features.
# ───────────────────────────────────────────────────────────────────────────

# ── AI provider ────────────────────────────────────────────────────────────
# Default provider. One of: anthropic | openai | gemini | rules
LLM_PROVIDER=anthropic

# Anthropic Claude (recommended default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (optional alternate provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (optional alternate provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Verification APIs ──────────────────────────────────────────────────────
# FuelEconomy.gov and NHTSA vPIC are public and need NO key — used automatically.

# Google Custom Search (optional — improves "source missing" lookups)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Google Business Profile / Places (optional — enables live rating cross-check)
GOOGLE_PLACES_API_KEY=

# ── Persistence ────────────────────────────────────────────────────────────
# Leave Supabase blank to use the local JSON store (default, zero-setup).
# To switch persistence to Supabase Postgres, set the project URL + service role
# key. On Vercel, prefer SUPABASE_URL (read at runtime) over the NEXT_PUBLIC_
# one (which is inlined at build time and fails if added after the build).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (only if you also use the Supabase client in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the local JSON store lives (default: ./.data)
DATA_DIR=./.data
